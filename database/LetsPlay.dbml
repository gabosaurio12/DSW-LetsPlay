Project lets_play {
  database_type: 'PostgreSQL'
}

enum request_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum community_type {
  PUBLIC
  PRIVATE
}

enum community_role {
  ADMIN
  MEMBER
}

enum account_status {
  ACTIVE
  DELETED
}

enum post_status {
  ACTIVE
  DELETED
}

enum videogame_status {
  ACTIVE
  DISABLED
}

enum community_status {
  ACTIVE
  DELETED
}

enum gender {
  UNDEFINED
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum report_content_type {
  POST
  COMMENT
  USER
  COMMUNITY
}

enum report_reason {
  TOXICITY
  INAPPROPRIATE
  SPAM
  SPOILER
  PIRACY
  OTHER
}

enum report_status {
  PENDING
  IN_REVIEW
  ATTENDED
  CLOSED
}

enum poll_status {
  ACTIVE
  CLOSED
}

enum play_style {
  CASUAL
  COMPETITIVE
  COOPERATIVE
  INDIFFERENT
}

enum lfg_post_status {
  OPEN
  COMPLETE
  CANCELLED
}

Table User {
  id_user uuid [pk]
  username varchar(12) [unique, not null]
  email varchar(255) [unique, not null]
  birth_date date [not null]
  gender gender [not null]
  password_hash varchar(255) [not null]
  display_name varchar(100)
  description text
  profile_photo_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  account_status account_status [not null]

  checks {
    `username ~ '^[A-Za-z0-9_]+$'` [name: 'chk_user_username_format']
  }
}

Table UserVideogames {
  id_user uuid [pk]
  id_videogame uuid [pk]
  added_at timestamptz [not null, default: `now()`]
}

Table ActiveSessions {
  token_hash varchar(64) [pk]
  id_user uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  checks {
    `expires_at > created_at` [name: 'chk_session_expiry_after_creation']
  }
}

Table GamerPreference {
  id_preference uuid [pk]
  id_user uuid [not null, unique]
  favorite_genres jsonb [not null]
  active_platforms jsonb [not null]
  availability jsonb [not null]
  preferred_style play_style [not null, default: 'INDIFFERENT']
  looking_to_play boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `jsonb_array_length(favorite_genres) BETWEEN 1 AND 5` [name: 'chk_preference_genres_range']
    `jsonb_array_length(active_platforms) BETWEEN 1 AND 5` [name: 'chk_preference_platforms_range']
    `jsonb_array_length(availability) >= 1` [name: 'chk_preference_availability_range']
  }
}

Table Follows {
  id_follower uuid [pk]
  id_followed uuid [pk]
  followed_at timestamptz [not null, default: `now()`]

  checks {
    `id_follower <> id_followed` [name: 'chk_follows_no_self']
  }
}

Table Blocks {
  id_blocker uuid [pk]
  id_blocked uuid [pk]
  blocked_at timestamptz [not null, default: `now()`]

  checks {
    `id_blocker <> id_blocked` [name: 'chk_blocks_no_self']
  }
}

Table Mutes {
  id_muter uuid [pk]
  id_muted uuid [pk]
  muted_at timestamptz [not null, default: `now()`]

  checks {
    `id_muter <> id_muted` [name: 'chk_mutes_no_self']
  }
}

Table Post {
  id_post uuid [pk]
  id_user uuid [not null]
  id_videogame uuid [not null]
  id_community uuid
  content text
  image_url varchar(500)
  is_spoiler boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  status post_status [not null]

  checks {
    `(content IS NOT NULL AND btrim(content) <> '') OR (image_url IS NOT NULL AND btrim(image_url) <> '')` [name: 'chk_post_not_empty']
  }
}

Table Comment {
  id_comment uuid [pk]
  id_post uuid [not null]
  id_user uuid [not null]
  content text [not null]
  is_spoiler boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(content) <> ''` [name: 'chk_comment_not_empty']
    `char_length(content) <= 500` [name: 'chk_comment_max_length']
  }
}

Table Reaction {
  id_user uuid [pk]
  id_post uuid [pk]
  reacted_at timestamptz [not null, default: `now()`]
}

Table Poll {
  id_poll uuid [pk]
  id_post uuid [not null, unique]
  question varchar(250) [not null]
  closes_at timestamptz
  status poll_status [not null]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `char_length(question) BETWEEN 5 AND 250 AND btrim(question) <> ''` [name: 'chk_poll_question']
  }
}

Table PollOption {
  id_option uuid [pk]
  id_poll uuid [not null]
  text varchar(100) [not null]
  position int [not null]

  indexes {
    (id_poll, position) [unique, name: 'uq_poll_option_position']
  }

  checks {
    `btrim(text) <> ''` [name: 'chk_poll_option_text']
    `position BETWEEN 1 AND 5` [name: 'chk_poll_option_position']
  }
}

Table PollVote {
  id_vote uuid [pk]
  id_poll uuid [not null]
  id_option uuid [not null]
  id_user uuid [not null]
  voted_at timestamptz [not null, default: `now()`]

  indexes {
    (id_poll, id_user) [unique, name: 'uq_poll_vote_user']
  }
}

Table LfgPost {
  id_lfg uuid [pk]
  id_user uuid [not null]
  id_videogame uuid [not null]
  platform varchar(50) [not null]
  spots_available int [not null]
  scheduled_time varchar(100) [not null]
  description text [not null]
  accepts_beginners boolean [not null, default: true]
  status lfg_post_status [not null]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `spots_available BETWEEN 1 AND 16` [name: 'chk_lfg_spots_range']
    `char_length(btrim(description)) BETWEEN 10 AND 500` [name: 'chk_lfg_description_length']
  }
}

Table Videogames {
  id_videogame uuid [pk]
  name varchar(150) [unique, not null]
  description text [not null]
  genre varchar(100)
  platform varchar(100)
  cover_url varchar(500)
  additional_info text
  created_at timestamptz [not null, default: `now()`]
  status videogame_status [not null]
}

Table VideogameRequests {
  id_request uuid [pk]
  id_requester uuid [not null]
  name varchar(150) [not null]
  description text [not null]
  genre varchar(100)
  platform varchar(100)
  cover_url varchar(500)
  additional_info text
  status request_status [not null]
  id_admin uuid
  rejection_reason text
  created_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz
  id_approved_videogame uuid

  checks {
    `(status = 'PENDING' AND id_admin IS NULL AND reviewed_at IS NULL AND rejection_reason IS NULL AND id_approved_videogame IS NULL) OR (status IN ('ACCEPTED', 'REJECTED') AND id_admin IS NOT NULL AND reviewed_at IS NOT NULL)` [name: 'chk_videogame_request_status']
    `status <> 'REJECTED' OR (rejection_reason IS NOT NULL AND btrim(rejection_reason) <> '')` [name: 'chk_videogame_request_rejection']
    `status <> 'ACCEPTED' OR id_approved_videogame IS NOT NULL` [name: 'chk_videogame_request_approval']
  }
}

Table Communities {
  id_community uuid [pk]
  id_creator uuid [not null]
  name varchar(150) [not null]
  description text [not null]
  type community_type [not null]
  image_url varchar(500)
  rules text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  status community_status [not null]
}

Table CommunityVideogames {
  id_community uuid [pk]
  id_videogame uuid [pk]
  associated_at timestamptz [not null, default: `now()`]
}

Table CommunityMembers {
  id_community uuid [pk]
  id_user uuid [pk]
  role community_role [not null]
  joined_at timestamptz [not null, default: `now()`]
}

Table CommunityJoinRequests {
  id_request uuid [pk]
  id_community uuid [not null]
  id_user uuid [not null]
  message text
  status request_status [not null]
  created_at timestamptz [not null, default: `now()`]
  answered_at timestamptz
  id_admin uuid
  admin_comment text

  checks {
    `(status = 'PENDING' AND answered_at IS NULL AND id_admin IS NULL AND admin_comment IS NULL) OR (status IN ('ACCEPTED', 'REJECTED') AND answered_at IS NOT NULL AND id_admin IS NOT NULL)` [name: 'chk_community_join_request_status']
  }
}

Table Report {
  id_report uuid [pk]
  id_reporter uuid [not null]
  content_type report_content_type [not null]
  id_reported_content uuid [not null]
  reason report_reason [not null]
  description text [not null]
  evidence_url varchar(500)
  status report_status [not null]
  id_reviewed_by uuid
  review_comment text
  created_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz

  checks {
    `btrim(description) <> ''` [name: 'chk_report_description']
    `(status = 'PENDING' AND id_reviewed_by IS NULL AND reviewed_at IS NULL) OR (status IN ('IN_REVIEW', 'ATTENDED', 'CLOSED') AND id_reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL)` [name: 'chk_report_status_review']
  }
}

Table Conversation {
  id_conversation uuid [pk]
  id_user_1 uuid [not null]
  id_user_2 uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id_user_1, id_user_2) [unique, name: 'uq_conversation_users']
  }

  checks {
    `id_user_1 <> id_user_2` [name: 'chk_conversation_distinct_users']
    `id_user_1 < id_user_2` [name: 'chk_conversation_canonical_order']
  }
}

Table Message {
  id_message uuid [pk]
  id_conversation uuid [not null]
  id_sender uuid [not null]
  id_recipient uuid [not null]
  content text [not null]
  sent_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(content) <> ''` [name: 'chk_message_not_empty']
    `id_sender <> id_recipient` [name: 'chk_message_distinct_users']
  }
}

Ref: UserVideogames.id_user > User.id_user
Ref: UserVideogames.id_videogame > Videogames.id_videogame
Ref: Follows.id_follower > User.id_user
Ref: Follows.id_followed > User.id_user
Ref: Blocks.id_blocker > User.id_user
Ref: Blocks.id_blocked > User.id_user
Ref: Mutes.id_muter > User.id_user
Ref: Mutes.id_muted > User.id_user
Ref: Post.id_user > User.id_user
Ref: Post.id_videogame > Videogames.id_videogame
Ref: Post.id_community > Communities.id_community
Ref: Post.(id_community, id_videogame) > CommunityVideogames.(id_community, id_videogame)
Ref: Comment.id_post > Post.id_post
Ref: Comment.id_user > User.id_user
Ref: Reaction.id_user > User.id_user
Ref: Reaction.id_post > Post.id_post
Ref: VideogameRequests.id_requester > User.id_user
Ref: VideogameRequests.id_admin > User.id_user
Ref: VideogameRequests.id_approved_videogame > Videogames.id_videogame
Ref: Communities.id_creator > User.id_user
Ref: CommunityVideogames.id_community > Communities.id_community
Ref: CommunityVideogames.id_videogame > Videogames.id_videogame
Ref: CommunityMembers.id_community > Communities.id_community
Ref: CommunityMembers.id_user > User.id_user
Ref: CommunityJoinRequests.id_community > Communities.id_community
Ref: CommunityJoinRequests.id_user > User.id_user
Ref: CommunityJoinRequests.id_admin > User.id_user
Ref: Report.id_reporter > User.id_user
Ref: Report.id_reviewed_by > User.id_user
Ref: Conversation.id_user_1 > User.id_user
Ref: Conversation.id_user_2 > User.id_user
Ref: Message.id_conversation > Conversation.id_conversation
Ref: Message.id_sender > User.id_user
Ref: Message.id_recipient > User.id_user
Ref: GamerPreference.id_user > User.id_user
Ref: ActiveSessions.id_user > User.id_user
Ref: Poll.id_post > Post.id_post
Ref: PollOption.id_poll > Poll.id_poll
Ref: PollVote.id_poll > Poll.id_poll
Ref: PollVote.id_option > PollOption.id_option
Ref: PollVote.id_user > User.id_user
Ref: LfgPost.id_user > User.id_user
Ref: LfgPost.id_videogame > Videogames.id_videogame
